// Espejo de las reglas activas en Firebase Console
// Si cambian acá, hay que pegarlas en Console a mano

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sin reglas generales: todo lo no matcheado se deniega
    function isSignedIn() {
      return request.auth != null;
    }

    // El userId del token coincide con el documento guardado
    function isOwnerExisting() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // El userId del token coincide con el documento entrante
    function isOwnerIncoming() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // Forma válida de tarea con tipos correctos
    function hasValidShape() {
      let data = request.resource.data;
      return data.title is string
        && data.description is string
        && data.completed is bool
        && data.userId is string;
    }

    match /tasks/{taskId} {
      allow get, list: if isOwnerExisting();
      allow create: if isOwnerIncoming() && hasValidShape();
      allow update: if isOwnerExisting() && isOwnerIncoming() && hasValidShape()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwnerExisting();
    }
  }
}
